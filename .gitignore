# Secrets: never commit real keys
.env

# Dependencies and build output
node_modules/
dist/
venv/
__pycache__/

# The SQLite file is rebuilt from data/events.json by `npm run seed`
*.db

# Terraform local state and provider downloads
terraform/.terraform/
terraform/*.tfstate*

# macOS
.DS_Store

# Security baseline: secrets, environments, logs, databases, raw data, model weights, OS files
.env.*
!.env.example
*.pem
*.key
*.p12
credentials*.json
secrets/
.venv/
*.log
logs/
*.sqlite3
data/raw/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.h5
